# Copie este archivo como .env y complete los valores. El archivo .env NO se sube a git.

# --- Correo (envío real del código de recuperación y notificaciones) ---
# Gmail: active la verificación en dos pasos y cree una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (16 caracteres). No use su contraseña normal.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=su-correo@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# Opcional: remitente que verá el destinatario (por defecto "WALMAR <EMAIL_HOST_USER>")
# DEFAULT_FROM_EMAIL=WALMAR <su-correo@gmail.com>

# Outlook/Hotmail: EMAIL_HOST=smtp-mail.outlook.com  EMAIL_PORT=587
# Para volver a imprimir los correos en consola, deje EMAIL_HOST_USER vacío.

# --- Acceso desde otros dispositivos ---
# Agregue la IP de su computador en la red local (ej. 192.168.1.20) para abrirla desde el mismo Wi-Fi.
# .trycloudflare.com permite el túnel público de Cloudflare (ver README).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.trycloudflare.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com

# --- Base de datos ---
# Sin estas variables se usa SQLite (db.sqlite3 en la carpeta del proyecto).
# POSTGRES_DB=walmar
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
